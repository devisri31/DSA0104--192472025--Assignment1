C++ Program – q3.cpp #include #include using namespace std;
class Auditorium { private: int rows; int seats; char** seatMap; int booked;

public: // Dynamic Constructor Auditorium(int r, int s) : rows(r), seats(s), seatMap(nullptr), booked(0) {

    if (rows < 0 || seats < 0) {
        throw invalid_argument("Invalid auditorium dimensions");
    }

    if (rows > 0) {
        seatMap = new char*[rows]();

        try {
            for (int i = 0; i < rows; i++) {
                seatMap[i] = new char[seats];

                for (int j = 0; j < seats; j++) {
                    seatMap[i][j] = 'O';
                }
            }
        }
        catch (...) {
            for (int i = 0; i < rows; i++) {
                delete[] seatMap[i];
            }
            delete[] seatMap;
            throw;
        }
    }

    cout << "Auditorium created: "
         << rows << " x " << seats << endl;
}

// Book a seat
void bookSeat(int r, int s) {
    if (r < 0 || r >= rows || s < 0 || s >= seats) {
        cout << "Invalid seat position!" << endl;
    }
    else if (seatMap[r][s] == 'X') {
        cout << "Seat already booked!" << endl;
    }
    else {
        seatMap[r][s] = 'X';
        booked++;
        cout << "Seat booked successfully." << endl;
    }
}

// Cancel a seat
void cancelSeat(int r, int s) {
    if (r < 0 || r >= rows || s < 0 || s >= seats) {
        cout << "Invalid seat position!" << endl;
    }
    else if (seatMap[r][s] == 'O') {
        cout << "Seat is already available." << endl;
    }
    else {
        seatMap[r][s] = 'O';
        booked--;
        cout << "Booking cancelled successfully." << endl;
    }
}

// Display seat map
void display() const {
    cout << "\nSeat Map:" << endl;

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < seats; j++) {
            cout << seatMap[i][j] << " ";
        }
        cout << endl;
    }

    cout << "Total booked seats: " << booked << endl;
}

// Destructor
~Auditorium() {
    for (int i = 0; i < rows; i++) {
        delete[] seatMap[i];
    }

    delete[] seatMap;

    cout << "Auditorium destroyed. "
         << "Total booked seats: " << booked << endl;
}
};

int main() {

cout << "1. Stack Object" << endl;

Auditorium a1(2, 3);
a1.bookSeat(0, 1);
a1.bookSeat(1, 2);
a1.display();

cout << "\n2. Block Scope Object" << endl;

{
    Auditorium a2(2, 2);
    a2.bookSeat(0, 0);
    a2.display();
}

cout << "\n3. Heap Object" << endl;

Auditorium* a3 = new Auditorium(3, 3);
a3->bookSeat(1, 1);
a3->display();

delete a3;

cout << "\nEnd of main function." << endl;

return 0;
}

