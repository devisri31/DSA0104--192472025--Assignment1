Aim To implement a C++ program using operator overloading to perform arithmetic operations, comparisons and input/output operations on money values stored in rupees and paise.
Theory Operator overloading allows existing C++ operators to work with user-defined objects.
The operators used are:

– Adds two Money objects.
– Subtracts two Money objects.
+= – Adds an amount to the existing object.
== – Checks whether two amounts are equal.
< – Compares two money amounts.
<< – Displays the money amount.
– Reads the money amount. The amount is stored internally as paise using long long to avoid floating-point precision problems.

Algorithm
Start the program.
Create a class named Money.
Declare a private data member paise.
Create a parameterized constructor.
Overload the + operator for addition.
Overload the - operator for subtraction.
Overload the += operator.
Overload == and < for comparison.
Overload << and >> for output and input.
Create Money objects and perform billing operations.
Display the results.
Stop the program.
C++ Program – q4.cpp #include #include #include using namespace std;
class Money { private: long long paise;

public: // Parameterized constructor Money(long long rupees = 0, int p = 0) : paise(rupees * 100 + p) {}

// TODO 1: Overload + operator
Money operator+(const Money& other) const {
    return Money(0, static_cast<int>(paise + other.paise));
}

// Subtraction operator
Money operator-(const Money& other) const {
    Money result;
    result.paise = paise - other.paise;
    return result;
}

// Compound assignment operator
Money& operator+=(const Money& other) {
    paise += other.paise;
    return *this;
}

// TODO 2: Equality operator
bool operator==(const Money& other) const {
    return paise == other.paise;
}

// Less-than operator
bool operator<(const Money& other) const {
    return paise < other.paise;
}

// Friend output operator
friend ostream& operator<<(ostream& out, const Money& m) {
    unsigned long long amount;

    if (m.paise < 0) {
        out << "-Rs ";
        amount = static_cast<unsigned long long>(
            -(m.paise + 1)
        ) + 1;
    } else {
        out << "Rs ";
        amount = static_cast<unsigned long long>(m.paise);
    }

    out << amount / 100 << "."
        << setfill('0') << setw(2)
        << amount % 100 << setfill(' ');

    return out;
}

// Friend input operator
friend istream& operator>>(istream& in, Money& m) {
    long long rupees;
    int p;

    if (in >> rupees >> p) {
        m.paise = rupees * 100 + p;
    }

    return in;
}
};

int main() { Money a(120, 75); Money b(79, 25);

// Addition
Money c = a + b;

cout << c << '\n';

// Equality comparison
cout << boolalpha << (c == Money(200)) << '\n';

// Paise carry test
Money x(0, 75);
Money y(0, 50);

cout << "Carry Test: " << x + y << '\n';

// Subtraction test
Money d(50, 0);
Money e(75, 0);

cout << "Negative Test: " << d - e << '\n';

// Compound assignment
d += x;
cout << "After += : " << d << '\n';

// Less-than comparison
cout << "Comparison: "
     << boolalpha << (d < e) << '\n';

return 0;
}

