Aim To implement a C++ program that overloads prefix and postfix increment operators, comparison operators, and the subscript operator using a Time class and a Playlist class.
Problem Description A music player maintains a playlist of tracks and a Time object to represent the current playback position.
The program must:

Overload prefix and postfix ++ to advance time by one second.
Overload == and < to compare two Time objects.
Overload [] in the Playlist class to access tracks.
Include range checking for invalid playlist indexes.
Demonstrate the operators through a playback simulation.
C++ Program Create a file named q5.cpp.
#include #include #include #include #include using namespace std;

class Time { private: int totalSeconds;

public: Time(int h = 0, int m = 0, int s = 0) { totalSeconds = h * 3600 + m * 60 + s; }

// Prefix increment
Time& operator++() {
    ++totalSeconds;
    return *this;
}

// Postfix increment
Time operator++(int) {
    Time old = *this;
    ++totalSeconds;
    return old;
}

// Equality operator
bool operator==(const Time& other) const {
    return totalSeconds == other.totalSeconds;
}

// Less-than operator
bool operator<(const Time& other) const {
    return totalSeconds < other.totalSeconds;
}

void display() const {
    int h = totalSeconds / 3600;
    int m = (totalSeconds % 3600) / 60;
    int s = totalSeconds % 60;

    cout << setfill('0')
         << setw(2) << h << ":"
         << setw(2) << m << ":"
         << setw(2) << s
         << setfill(' ');
}
};

class Playlist { private: vector tracks;

public: Playlist(vector t) : tracks(t) {}

// Non-const subscript operator
string& operator[](int index) {
    if (index < 0 || index >= static_cast<int>(tracks.size())) {
        throw out_of_range("Invalid playlist index");
    }
    return tracks[index];
}

// Const subscript operator
const string& operator[](int index) const {
    if (index < 0 || index >= static_cast<int>(tracks.size())) {
        throw out_of_range("Invalid playlist index");
    }
    return tracks[index];
}

int size() const {
    return static_cast<int>(tracks.size());
}
};

int main() { cout << "MUSIC PLAYER SIMULATION\n";

// Increment operator demonstration
Time t(0, 0, 5);

Time a = t++;
Time b = ++t;

cout << "\nPostfix result: ";
a.display();

cout << "\nPrefix result: ";
b.display();

cout << "\nCurrent time: ";
t.display();

// Comparison operators
Time x(0, 0, 7);
Time y(0, 0, 10);

cout << "\n\nTime Comparison:\n";
cout << boolalpha;
cout << "x == t: " << (x == t) << endl;
cout << "x < y: " << (x < y) << endl;

// Playlist demonstration
Playlist songs({"Perfect", "Shape of You", "Believer"});

cout << "\nPlaylist:\n";

for (int i = 0; i < songs.size(); i++) {
    cout << i << ". " << songs[i] << endl;
}

// Modify a track using non-const operator[]
songs[1] = "Photograph";

cout << "\nUpdated second track: " << songs[1] << endl;

// Minute and hour rollover
Time rollover(0, 59, 59);
++rollover;

cout << "\nAfter rollover: ";
rollover.display();

// Invalid index testing
cout << "\n\nRange Check:\n";

try {
    cout << songs[-1] << endl;
}
catch (const out_of_range& e) {
    cout << e.what() << endl;
}

try {
    cout << songs[songs.size()] << endl;
}
catch (const out_of_range& e) {
    cout << e.what() << endl;
}

return 0;
}

