Aim To implement a user-defined Text class using dynamic memory allocation and demonstrate constructor, copy constructor, copy assignment, destructor and operator overloading.
Problem Description An SMS gateway uses a custom Text class to store messages. The class must support:
Dynamic memory allocation for text.
Copy constructor and copy assignment.
Concatenation using +.
Comparison using == and !=.
Printing using <<.
Safe self-assignment and memory management.
C++ Program Create a file named q6.cpp.
#include #include using namespace std;

class Text { private: char* data; static int copyCount;

public: // Constructor Text(const char* str = "") { data = new char[strlen(str) + 1]; strcpy(data, str); }

// Copy constructor
Text(const Text& other) {
    data = new char[strlen(other.data) + 1];
    strcpy(data, other.data);
    copyCount++;
    cout << "Copy constructor called\n";
}

// Copy assignment operator
Text& operator=(const Text& other) {
    if (this != &other) {
        char* newData = new char[strlen(other.data) + 1];
        strcpy(newData, other.data);

        delete[] data;
        data = newData;
    }
    return *this;
}

// Destructor
~Text() {
    delete[] data;
}

// Concatenation operator
Text operator+(const Text& other) const {
    size_t len1 = strlen(data);
    size_t len2 = strlen(other.data);

    char* combined = new char[len1 + len2 + 1];

    strcpy(combined, data);
    strcat(combined, other.data);

    Text result(combined);
    delete[] combined;

    return result;
}

// Equality operator
bool operator==(const Text& other) const {
    return strcmp(data, other.data) == 0;
}

// Inequality operator
bool operator!=(const Text& other) const {
    return !(*this == other);
}

// Display operator
friend ostream& operator<<(ostream& out, const Text& t) {
    out << t.data;
    return out;
}

static int getCopyCount() {
    return copyCount;
}

static void resetCopyCount() {
    copyCount = 0;
}
};

int Text::copyCount = 0;

int main() { Text a("Hello "); Text b("World"); Text c("!");

cout << "SMS TEXT CLASS\n";

// Concatenation
Text message = a + b + c;
cout << "Combined Message: " << message << endl;

// Comparison
Text x("Hello");
Text y("Hello");
Text z("Welcome");

cout << "\nComparison:\n";
cout << boolalpha;
cout << "x == y: " << (x == y) << endl;
cout << "x != z: " << (x != z) << endl;

// Copy constructor
Text copy = message;
cout << "\nCopied Message: " << copy << endl;

// Copy assignment
Text assigned;
assigned = message;
cout << "Assigned Message: " << assigned << endl;

// Self assignment
assigned = assigned;
cout << "After Self Assignment: " << assigned << endl;

// Empty text
Text empty("");
cout << "\nEmpty Message: [" << empty << "]" << endl;

// Long message
Text longMessage(
    "This is a long SMS message used for testing dynamic memory allocation."
);

cout << "Long Message: " << longMessage << endl;

// Copy count for a + b + c
Text::resetCopyCount();
Text combined = a + b + c;

cout << "\nCopy Count for a + b + c: "
     << Text::getCopyCount() << endl;

return 0;
}

Important: The class uses a dynamically allocated character array. The copy constructor creates a separate array, and the assignment operator handles self-assignment safely. 4. Expected Output Illustrative output for C++17. Copy-count behavior is explained below. SMS TEXT CLASS Combined Message: Hello World!

