Stage 3 – Implementation and Verification (3 Marks) A. C++ Program Create a file named q7.cpp.
#include #include #include #include using namespace std;

class Complex { private: double real; double imag;

public: // Default constructor Complex() : real(0), imag(0) {}

// Constructor with real part
Complex(double r) : real(r), imag(0) {}

// Constructor with real and imaginary parts
Complex(double r, double i) : real(r), imag(i) {}

// Addition
Complex operator+(const Complex& other) const {
    return Complex(real + other.real,
                   imag + other.imag);
}

// Subtraction
Complex operator-(const Complex& other) const {
    return Complex(real - other.real,
                   imag - other.imag);
}

// Multiplication
Complex operator*(const Complex& other) const {
    return Complex(
        real * other.real - imag * other.imag,
        real * other.imag + imag * other.real
    );
}

// Division
Complex operator/(const Complex& other) const {
    double denominator =
        other.real * other.real +
        other.imag * other.imag;

    if (denominator < 1e-12) {
        throw domain_error("Division by zero impedance");
    }

    return Complex(
        (real * other.real + imag * other.imag) / denominator,
        (imag * other.real - real * other.imag) / denominator
    );
}

// Equality comparison
bool operator==(const Complex& other) const {
    const double EPS = 1e-9;

    return fabs(real - other.real) < EPS &&
           fabs(imag - other.imag) < EPS;
}

// Magnitude
double magnitude() const {
    return sqrt(real * real + imag * imag);
}

// Output operator
friend ostream& operator<<(ostream& out,
                           const Complex& z) {
    out << fixed << setprecision(2);
    out << z.real;

    if (z.imag >= 0)
        out << " + j" << z.imag;
    else
        out << " - j" << -z.imag;

    return out;
}
};

