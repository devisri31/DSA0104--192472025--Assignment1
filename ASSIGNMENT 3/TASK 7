cout << boolalpha;
cout << "Equality: " << (a == b) << endl;

cout << "Magnitude of A: "
     << a.magnitude() << endl;

// RLC circuit values
double R = 10.0;
double XL = 5.0;
double XC = 10.0;

// Individual impedances
Complex ZR(R, 0);
Complex ZL(0, XL);
Complex ZC(0, -XC);

// Series RLC impedance
Complex Zseries = ZR + ZL + ZC;

cout << "\nSeries RLC Circuit:\n";
cout << "Impedance: " << Zseries << endl;
cout << "Magnitude: "
     << Zseries.magnitude() << endl;

// Parallel RLC impedance
Complex Zparallel =
    (ZR * ZL) / (ZR + ZL);

Zparallel =
    (Zparallel * ZC) / (Zparallel + ZC);

cout << "\nParallel RLC Circuit:\n";
cout << "Impedance: " << Zparallel << endl;
cout << "Magnitude: "
     << Zparallel.magnitude() << endl;

// Division by zero test
cout << "\nDivision by Zero Test:\n";

try {
    Complex zero(0, 0);
    Complex result = a / zero;
    cout << result << endl;
}
catch (const domain_error& e) {
    cout << "Error: " << e.what() << endl;
}

return 0;
}

